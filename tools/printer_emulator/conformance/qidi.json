{
 "personality": "qidi",
 "about": "Every field EdgeSlicer reads from, or sends to, a QIDI printer on Moonraker (with or without a QIDI Box) through PrintHostDevices, and whether the emulator provides it. See elegoo_cc1.json for the statuses. The same probe also reads a Snapmaker's print_task_config: those fields are not in a QIDI's protocol (the u1 ledger covers them).",
 "read_sources": ["src/slic3r/Utils/PrintHostDeviceStatus.cpp"],
 "send_sources": {"macros": ["src/slic3r/Utils/PrintHostDeviceStatus.cpp"],
                  "endpoints": ["src/slic3r/Utils/PrintHostDeviceStatus.cpp", "src/slic3r/Utils/PrintHost.cpp", "src/slic3r/Utils/MoonRaker.cpp"]},
 "emulator_sources": ["tools/printer_emulator/personalities/qidi.py", "tools/printer_emulator/personalities/moonraker.py",
                      "tools/printer_emulator/personalities/klipper.py"],
 "reads": {
  "T<n>": {"status": "not_in_protocol", "note": "a slot label (T1, T2 ...) built for the dialog"},
  "box": {"status": "deferred", "note": "an alternative nesting (multi_color_controller.box.{...}) the reader tolerates; the emulator sends the flat form EdgeSlicer and QIDIStudio read first"},
  "box<n>": {"status": "provided", "prefix": true, "note": "multi_color_controller flat keys box<b>_box_inserted_<n>, box<b>_filament_info_<n>_... (QIDIStudio 2026-10-19 shape, qidi.mcc_shape flat); box0 is Box 1"},
  "box_count": {"status": "provided"},
  "box_inserted_": {"status": "provided", "prefix": true, "note": "box_inserted_<n>, built at run time"},
  "box_inserted_<n>": {"status": "provided"},
  "boxes": {"status": "provided"},
  "color_rgb_str": {"status": "provided"},
  "color_slot": {"status": "provided", "prefix": true, "note": "color_slot<n>, built at run time"},
  "color_slot<n>": {"status": "provided"},
  "enable_box": {"status": "provided"},
  "filament_color_rgba": {"status": "not_in_protocol", "note": "a Snapmaker's print_task_config (u1 ledger)"},
  "filament_exist": {"status": "not_in_protocol", "note": "a Snapmaker's print_task_config (u1 ledger)"},
  "filament_info": {"status": "provided"},
  "filament_info_<n>": {"status": "provided", "note": "the flat key box<b>_filament_info_<n>_filament_type / _filament_str / _vendor_str / _color_rgb_str"},
  "filament_slot": {"status": "provided", "prefix": true, "note": "filament_slot<n>, built at run time"},
  "filament_slot0": {"status": "provided"},
  "filament_slot<n>": {"status": "provided"},
  "filament_str": {"status": "provided"},
  "filament_sub_type": {"status": "not_in_protocol", "note": "a Snapmaker's print_task_config (u1 ledger)"},
  "filament_type": {"status": "provided", "note": "multi_color_controller filament_info[].filament_type (also a Snapmaker field)"},
  "filament_vendor": {"status": "not_in_protocol", "note": "a Snapmaker's print_task_config (u1 ledger)"},
  "multi_color_controller": {"status": "provided"},
  "nozzle_diameter": {"status": "provided"},
  "output_pin polar_cooler": {"status": "provided"},
  "print_stats": {"status": "provided"},
  "print_task_config": {"status": "not_in_protocol", "note": "a Snapmaker object; a QIDI leaves it out, as the emulator does"},
  "result": {"status": "provided"},
  "runout_button": {"status": "provided", "note": "box_stepper slot<n>.runout_button, 0 = filament at the slot sensor (QIDIStudio 2.07.02.60); a stepper the printer lacks answers {}"},
  "save_variables": {"status": "provided"},
  "slot": {"status": "provided", "prefix": true, "note": "save_variables slot<n> (n 0..15), the slot's state word: 0 empty, 1 / 2 / 3 filament there, negative blocked"},
  "slot<n>": {"status": "not_in_protocol", "note": "a value (value_t<n> = 'slot<n>'), not a key; the emulator stores and returns it"},
  "state": {"status": "provided"},
  "status": {"status": "provided"},
  "value_t": {"status": "provided", "prefix": true, "note": "value_t<n>, built at run time"},
  "value_t<n>": {"status": "provided"},
  "variables": {"status": "provided"},
  "vendor_str": {"status": "provided"}
 },
 "sends": {
  "/printer/objects/query": {"status": "provided"},
  "/server/files/config/officiall_filas_list.cfg": {"status": "provided", "note": "synthetic content"},
  "G31": {"status": "provided"},
  "G32": {"status": "provided"},
  "SAVE_VARIABLE": {"status": "provided"},
  "VALUE=": {"status": "provided"},
  "VARIABLE=": {"status": "provided"}
 }
}
