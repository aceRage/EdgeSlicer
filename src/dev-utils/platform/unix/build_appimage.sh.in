#!/usr/bin/env bash
APPIMAGETOOLURL="https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-$(uname -m).AppImage"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# build_appimage.sh is generated under top-level CMake binary dir (e.g. ./build)
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

APP_IMAGE="@SLIC3R_APP_KEY@_Linux_V@Snapmaker_VERSION@.AppImage"

wget ${APPIMAGETOOLURL} -O ../appimagetool.AppImage
chmod +x ../appimagetool.AppImage

if [ -f /.dockerenv ]; then
    sed '0,/AI\x02/{s|AI\x02|\x00\x00\x00|}' -i ../appimagetool.AppImage
fi

mv @SLIC3R_APP_CMD@ AppRun
chmod +x AppRun

# The AppStream ID, and so the base name of both the .desktop entry and the metainfo file, comes
# from scripts/flatpak/: appimagetool rejects a bundle whose metainfo <id> and desktop file name
# disagree. It is deliberately not @SLIC3R_APP_KEY@ - that is the short app key ("EdgeSlicer"),
# used for the binary, the icon and the AppImage file name, not the reverse-DNS component id.
APP_ID="io.github.acerage.EdgeSlicer"

# The icon files keep their historical base name: the rebrand replaced the artwork in place rather
# than renaming the files, and the whole GUI (AboutDialog, ConfigWizard, MsgDialog, ...) still asks
# for Snapmaker_Orca_192px.png by that name. Only the *installed* icon is named for the app key,
# which is what the Icon= key below refers to.
ICON_SRC="resources/images/Snapmaker_Orca_192px.png"
if [[ ! -f "${ICON_SRC}" ]]; then
    echo "Error: missing ${ICON_SRC}"
    exit 1
fi
cp "${ICON_SRC}" @SLIC3R_APP_KEY@.png
mkdir -p usr/share/icons/hicolor/192x192/apps
cp "${ICON_SRC}" usr/share/icons/hicolor/192x192/apps/@SLIC3R_APP_KEY@.png

cat >${APP_ID}.desktop <<EOF
[Desktop Entry]
Name=EdgeSlicer
Exec=AppRun %F
Icon=@SLIC3R_APP_KEY@
Type=Application
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true
Categories=Graphics;3DGraphics;Engineering;
MimeType=model/stl;model/3mf;application/vnd.ms-3mfdocument;application/prs.wavefront-obj;application/x-amf;
EOF

mkdir -p usr/share/applications
cp ${APP_ID}.desktop usr/share/applications/

mkdir -p usr/share/metainfo
META_SRC="${REPO_ROOT}/scripts/flatpak/${APP_ID}.metainfo.xml"
if [[ ! -f "${META_SRC}" ]]; then
    echo "Error: missing ${META_SRC}"
    exit 1
fi
cp "${META_SRC}" usr/share/metainfo/${APP_ID}.metainfo.xml
cp "${META_SRC}" usr/share/metainfo/${APP_ID}.appdata.xml

export ARCH=$(uname -m)

# Write into cwd (package_appimage); build_linux_image.sh moves it to the CMake build dir.
OUT="${APP_IMAGE}"
rm -f "${OUT}"

if [ -f /.dockerenv ]; then
    ../appimagetool.AppImage --appimage-extract-and-run . "${OUT}" $([ -n "${container}" ] && echo '--appimage-extract-and-run')
else
    ../appimagetool.AppImage . "${OUT}" $([ -n "${container}" ] && echo '--appimage-extract-and-run')
fi

chmod +x "${OUT}"
